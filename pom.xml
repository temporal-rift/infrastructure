<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.temporal-rift</groupId>
        <artifactId>temporal-rift-bom</artifactId>
        <version>1.5.3</version>
        <relativePath/>
    </parent>

    <artifactId>temporal-rift-system-tests</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Temporal Rift System Tests</name>
    <description>Black-box end-to-end verification for the Temporal Rift deployment topology</description>

    <properties>
        <maven.exec.version>3.5.0</maven.exec.version>
        <sonar.organization>temporal-rift</sonar.organization>
        <sonar.projectKey>temporal-rift_infrastructure</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${maven.exec.version}</version>
            </plugin>
            <!-- Version/executions (prepare-agent, XML report) inherited from temporal-rift-bom's
                 pluginManagement, matching every sibling Java service. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${maven.exec.version}</version>
                        <executions>
                            <execution>
                                <id>reset-system-under-test</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-p</argument>
                                        <argument>temporal-rift-e2e</argument>
                                        <argument>-f</argument>
                                        <argument>compose.yml</argument>
                                        <argument>-f</argument>
                                        <argument>src/test/resources/compose.e2e.yml</argument>
                                        <argument>down</argument>
                                        <argument>-v</argument>
                                        <argument>--remove-orphans</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>start-system-under-test</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-p</argument>
                                        <argument>temporal-rift-e2e</argument>
                                        <argument>-f</argument>
                                        <argument>compose.yml</argument>
                                        <argument>-f</argument>
                                        <argument>src/test/resources/compose.e2e.yml</argument>
                                        <argument>up</argument>
                                        <argument>--build</argument>
                                        <argument>--wait</argument>
                                        <argument>--wait-timeout</argument>
                                        <argument>420</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Must be declared before stop-system-under-test: both bind to
                                     post-integration-test, and same-phase executions of one plugin run
                                     in POM declaration order. Captures logs while the stack still exists —
                                     Failsafe records failures without failing the build until the later
                                     verify phase, so by then the stack below would already be gone. -->
                                <id>capture-e2e-diagnostics</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>src/test/resources/capture-e2e-diagnostics.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-system-under-test</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-p</argument>
                                        <argument>temporal-rift-e2e</argument>
                                        <argument>-f</argument>
                                        <argument>compose.yml</argument>
                                        <argument>-f</argument>
                                        <argument>src/test/resources/compose.e2e.yml</argument>
                                        <argument>down</argument>
                                        <argument>-v</argument>
                                        <argument>--remove-orphans</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <!-- Explicit rather than relying on the default **/*IT.java pattern, so
                                         that adding an IT class under a different profile's test package
                                         (e.g. systemtest/security/) can never change what this profile runs. -->
                                    <includes>
                                        <include>**/TemporalRiftSystemIT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Proves infrastructure#38's authenticated, least-privilege-authorized Kafka topology.
                 Boots a wholly separate, standalone stack (compose.secure.yml, project name
                 temporal-rift-secure) with its own broker and ports, never compose.yml or
                 compose.e2e.yml, so the local dev flow and the `e2e` profile's suite are both
                 untouched by this profile existing. -->
            <id>security-e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${maven.exec.version}</version>
                        <executions>
                            <execution>
                                <id>reset-secure-system-under-test</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-f</argument>
                                        <argument>compose.secure.yml</argument>
                                        <argument>down</argument>
                                        <argument>-v</argument>
                                        <argument>--remove-orphans</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>start-secure-system-under-test</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-f</argument>
                                        <argument>compose.secure.yml</argument>
                                        <argument>up</argument>
                                        <argument>--build</argument>
                                        <argument>--wait</argument>
                                        <argument>--wait-timeout</argument>
                                        <argument>180</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- The "up" execution's wait flag only waits for kafka-secure-provision to
                                     be running, not to finish: it has no healthcheck, and that flag
                                     considers a healthcheck-less container ready as soon as it starts.
                                     kafka-acls.sh spins up a fresh JVM per grant, so the provisioning script
                                     can still be mid-run (topics created, ACLs partially granted) once the
                                     previous execution returns. This "wait" subcommand instead blocks until
                                     the container actually exits and fails the build on a nonzero code. -->
                                <id>await-secure-provisioning</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-f</argument>
                                        <argument>compose.secure.yml</argument>
                                        <argument>wait</argument>
                                        <argument>kafka-secure-provision</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Declared before stop-secure-system-under-test for the same reason as
                                     the e2e profile's capture-e2e-diagnostics: same-phase executions of one
                                     plugin run in POM declaration order, and the stack must still exist. -->
                                <id>capture-security-e2e-diagnostics</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>src/test/resources/capture-security-e2e-diagnostics.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-secure-system-under-test</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>compose</argument>
                                        <argument>-f</argument>
                                        <argument>compose.secure.yml</argument>
                                        <argument>down</argument>
                                        <argument>-v</argument>
                                        <argument>--remove-orphans</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/security/*IT.java</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
