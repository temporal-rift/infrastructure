{
  "uid": "temporal-rift-consumer-lag",
  "title": "Consumer lag",
  "tags": ["temporal-rift", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer group lag by partition",
      "description": "kafka_consumergroup_lag per consumer group, topic, and partition. Alerts on KafkaConsumerGroupLagHigh (see observability/vmalert/rules.yml).",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} / {{topic}} / {{partition}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer group lag, summed by topic",
      "description": "kafka_consumergroup_lag_sum per consumer group and topic, across all partitions.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_lag_sum",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
